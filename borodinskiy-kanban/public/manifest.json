{
  "manifest_version": 3,
  "name": "Borodinskiy Kanban",
  "version": "1.0.0",
  "description": "Flexible and customizable Kanban board.",
  "action": {
    "default_title": "Open Borodinskiy Kanban"
  },
"icons": {
    "16": "icons/icon128.svg",
    "32": "icons/icon128.svg",
    "48": "icons/icon128.svg",
    "128": "icons/logo_square128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ]
}