{
  "manifest_version": 3,
  "name": "Borodinskiy Kanban",
  "version": "1.0.0",
  "description": "Flexible and customizable Kanban board.",
  "action": {
    "default_title": "Open Borodinskiy Kanban"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ]
}