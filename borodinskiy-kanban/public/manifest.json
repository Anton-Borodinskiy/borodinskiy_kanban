{
  "manifest_version": 3,
  "name": "Borodinskiy Kanban",
  "version": "1.0.0",
  "description": "Flexible and customizable Kanban board.",
  "action": {
    "default_title": "Open Borodinskiy Kanban"
  },
  "icons": {
    "16": "data:image/svg+xml;base64,",
    "32": "data:image/svg+xml;base64,",
    "48": "data:image/svg+xml;base64,",
    "128": "data:image/svg+xml;base64,"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ]
}